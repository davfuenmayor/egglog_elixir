# Elixir / Mix build artifacts
/_build/
/deps/
/cover/
/doc/
/tmp/

# Rustler / native build artifacts
/priv/native/
/native/**/target/

# Package/archive outputs
/*.ez
/egglog_elixir-*.tar
/egglog_elixir-*/

# Keep only distributable native bundles and their documentation
/native/precompiled/*
!/native/precompiled/README.md
!/native/precompiled/egglog-*.tar.gz
!/native/precompiled/egglog-*.tar.gz.sha256

# Crash dumps and runtime logs
erl_crash.dump
*.dump
*.log

# Livebook local state and generated exports/artifacts
.livemd_checkpoints/
livebook_import/
livebook_uploads/
*.livemd.autosave

# Elixir language server and editor state
/.elixir_ls/
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
Desktop.ini
*.exe.stackdump

# Release staging and local tooling state
/dist/
/.expert/
